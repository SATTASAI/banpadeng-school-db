{
  "name": "banpadeng-school-db",
  "keep_vars": true,
  "compatibility_date": "2024-09-23",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "FILE_STORAGE_PROVIDER": "drive",
    "GOOGLE_DRIVE_FOLDER_ID": "1miKzaiIj3Y0CJ1RQHma7cDA7G3pz6ca9",
    // แจ้งเตือนบนมือถือ (Web Push ผ่าน school-notify) — Secret: NOTIFY_API_KEY = API_KEY ของ school-notify
    // ช่วงทดลอง ส่งเฉพาะบทบาทเหล่านี้ (คั่นด้วยจุลภาค, all = ทุกคน)
    "NOTIFY_ORIGIN": "https://notify.banpadengschool.ac.th",
    "PUSH_PILOT_ROLES": "all"
  },
  // รหัสเวอร์ชันของการ deploy: ใช้ตั้งค่าโครงสร้างฐานข้อมูลครั้งเดียวต่อ deploy (src/lib/schema-stamp.js)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // ส่งแจ้งเตือนทุกระบบทาง LINE รายบุคคล (src/lib/line-feed.js) — เก็บตกทุก 2 นาที
  "triggers": { "crons": ["*/2 * * * *"] },
  // ไฟล์ R2 เดิม (อ่านอย่างเดียว; ไฟล์ใหม่เก็บใน Google Drive) — ต้องประกาศในไฟล์นี้ ไม่งั้น binding หายทุกครั้งที่ deploy
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "banpadeng-school-files" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "banpadeng_school_db",
      "database_id": "870fa9ec-122f-4161-a1ca-cc9979dcfa30"
    },
    // ฐานข้อมูลของระบบธนาคารโรงเรียน (แยกเป็นอีกระบบ) — ใช้อ่านอย่างเดียว: ตรวจว่านักเรียนยังมีบัญชีเปิดอยู่ก่อนลบถาวร
    {
      "binding": "BANK_DB",
      "database_name": "banpadeng-school-bank-db",
      "database_id": "899e0c19-96c0-48f6-ada8-b06c7b628aca"
    }
  ]
}
